# 01_hello_ai.ibci
# IBCI 入门：行为描述 + AI 交互

# 本示例展示 IBCI 的核心特性：
# 1. 行为描述语句 - 用 @~...~ 语法直接调用 AI
# 2. LLM 函数 - 用 llm 关键字定义 AI 函数
# 3. 意图注释 - 用 @ 编写意图注释，作为场景控制/额外提示词注入

import ai
import fs
import json

# ============================================================
# 配置 AI
# ============================================================

print("\n--- AI 配置 ---\n")

# 显式加载 project_root/api_config.json（F9：配置加载为显式动作，引擎不再自动加载）；
# 无配置时 MOCK 模式开箱即跑
ai.load_project_config()
if not ai.has_api_key():
    print("未检测到 api_config.json，切换至 MOCK 模式。")
    ai.set_mock_mode()

print("AI 已配置就绪")

# ============================================================
# 行为描述语句
# ============================================================

print("\n--- 行为描述语句 ---\n")

str greeting = "你好，请打个招呼"
str result = @~ 请根据要求进行回复： $greeting ~
print("llm 回复的打招呼内容：")
print(result)

print("\n")

int a = 10
int b = 20
int sum = @~ 请计算 $a 和 $b 之和~
print("llm 回复的计算结果：")
print((str)sum)

# ============================================================
# LLM 函数
# ============================================================

print("\n--- LLM 函数 ---\n")

# 定义一个 llm 可调用类（LLMCallable 协议：实现 __llm_call__）
# llm 可调用类实例是"可调用实例 + 协议（类型类）"统一机制的一员：
# 实例可直接调用（参数按位绑定 __llm_call__ 非 self 参数）。
class 翻译:
    func __llm_call__(self, any 文本, any 目标语言) -> dict:
        return {"user_prompt": "请将以下内容翻译成 " + str(目标语言) + "：" + str(文本), "prompt_slots": [{"kind": "user_sys", "text": "你是一个翻译助手，只返回翻译结果。不输出任何额外内容"}]}

翻译 t = 翻译()
str chinese_text = "编程让世界更美好"
str english_text = t(chinese_text, "English")
print("原文: " + chinese_text)
print("翻译: " + english_text)

# ============================================================
# 意图注释
# ============================================================

print("\n--- 意图注释 ---\n")

# 意图注释是ibc-inter中的重要特性，用于动态地向提示词注入额外约束
@ 用客观无感情且最简洁的方式回复用户
str result_of_intent_control = @~打个招呼~
print("客观无感情且最简洁的回复结果：")
print(result_of_intent_control)

print("\n")

# llm 可调用类自身保持不变，利用意图注释注入额外约束
@ 所有英文回复信息都采用大写字母
english_text = t(chinese_text, "English")
print("增加了额外的大写字母约束的回复结果")
print("翻译: " + english_text)
