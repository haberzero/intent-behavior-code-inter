# 03_flow_control_and_behavior.ibci
# IBCI 进阶：流控与行为描述语句结合使用

# 本示例展示 IBCI 中流控语句与行为描述语句的结合使用：
# 1. if - 意图驱动的条件判断
# 2. while - 意图驱动的条件循环
# 3. for - 行为描述作为迭代条件
#
# 注：本示例使用 MOCK 指令确保零配置可跑通。
# 实际使用中，行为表达式内可写自然语言（如 @~$text 是否积极？~），
# 由 LLM 返回 bool 结果。

import ai
import fs
import json
import idbg

# ============================================================
# 配置 AI
# ============================================================

print("\n=== AI 配置 ===\n")

# 显式加载 project_root/api_config.json（F9：配置加载为显式动作，引擎不再自动加载）；
# 无配置时 MOCK 模式开箱即跑
ai.load_project_config()
if not ai.has_api_key():
    print("未检测到 api_config.json，切换至 MOCK 模式。")
    ai.set_mock_mode()

print("AI 已配置就绪")

# ============================================================
# 1. if - 意图驱动的条件判断
# ============================================================

print("\n=== 1. if 意图驱动条件判断 ===\n")

str input_text = "今天天气真不错！"
print("输入文本: " + input_text)

# MOCK:TRUE 模拟 LLM 返回"是"，实际场景中写自然语言如 @~$input_text 是否包含积极情绪？~
if @~MOCK:TRUE 情绪分析~:
    print("检测到积极情绪！")
    idbg.show_all()
else:
    print("未检测到积极情绪")
    idbg.show_all()

# ============================================================
# 2. while - 意图驱动的条件循环
# ============================================================

print("\n=== 2. while 意图驱动条件循环 ===\n")

str user_input = "开始"
int loop_count = 0

# MOCK:SEQ 按序返回：前两次 TRUE（继续循环），第三次 FALSE（退出）
print("开始循环判断...")
while @~MOCK:SEQ:[TRUE,TRUE,FALSE] 是否继续~:
    loop_count = loop_count + 1
    print("循环第 " + (str)loop_count + " 次")
    idbg.show_all()

print("循环结束，共循环 " + (str)loop_count + " 次")

# ============================================================
# 3. for with behavior expression - 行为描述作为迭代条件
# ============================================================

print("\n=== 3. for + 行为描述迭代 ===\n")

str continue_flag = "yes"
int for_count = 0

# MOCK:SEQ 按序返回：前两次 TRUE（继续），第三次 FALSE（退出）
for @~MOCK:SEQ:[TRUE,TRUE,FALSE] 继续循环？~:
    for_count = for_count + 1
    print("for 循环第 " + (str)for_count + " 次")
    idbg.show_all()

print("for 循环结束，共执行 " + (str)for_count + " 次")

# ============================================================
# 4. 嵌套条件判断
# ============================================================

print("\n=== 4. 嵌套条件判断 ===\n")

str content = "这是一个关于编程的教程"
print("分析内容: " + content)

# 外层返回 TRUE，内层返回 FALSE — 展示分支走 else 路径
if @~MOCK:TRUE 技术关键词检测~:
    print("  -> 外层判断：包含技术关键词")

    if @~MOCK:FALSE Python内容检测~:
        print("  -> 内层判断：包含 Python 内容")
        idbg.show_all()
    else:
        print("  -> 内层判断：不包含 Python 内容")
        idbg.show_all()

else:
    print("  -> 外层判断：不包含技术关键词")

print("\n=== 流控与行为描述结合演示结束 ===\n")
