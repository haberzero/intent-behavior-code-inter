# 01_file_operations.ibci
# 文件操作（kernel-native file 模块）
#
# 设计要点（ADR-020 G6）：
# - file_handle 实例是只读路径引用，不持有 OS fd。
# - 所有写入必须通过 file 模块的显式函数完成。
# - write_overwrite 是副作用写入：影响所有共享同一 backing 路径的 handle。
# - write_copy 是 copy-on-write：创建新文件，不影响原 handle。

import file
import isys

print("=== file module demo ===")

str demo = "./demo.txt"

print("\n[1] overwrite write")
file.write_overwrite(demo, "line1\nline2\nline3")
print("wrote: " + demo)

print("\n[2] open as read-only handle and read")
file_handle fh = file.open(demo)
str content = file.read(fh)
print("content:\n" + content)

print("\n[3] copy-on-write: new file, original untouched")
file_handle copy = file.write_copy(fh, "./demo_copy.txt", "copied content")
print("copy content: " + file.read(copy))
print("original still: " + file.read(fh))

print("\n[4] overwrite mutates the shared backing")
file.write_overwrite(fh, "mutated content")
print("original now: " + file.read(fh))
print("copy still: " + file.read(copy))

print("\n[5] exists / remove")
print("demo exists: " + (str)file.exists(demo))
file.remove(fh)
file.remove(copy)
print("after remove, demo exists: " + (str)file.exists(demo))

print("\n[6] path introspection")
print("project_root: " + isys.project_root())
print("entry_dir: " + isys.entry_dir())
print("handle path field: " + fh.path)
