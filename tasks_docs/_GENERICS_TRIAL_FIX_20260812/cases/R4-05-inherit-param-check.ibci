# R4-05 双通道 继承特化类方法参数类型检查
# doc: docs/syntax/06_oop.md §6.4
# 期望: 继承特化类方法参数校验
import ai
ai.set_mock_mode()
class Base[T]:
    T val
    func set_val(self, T v) -> void:
        self.val = v
class Sub[T](Base[T]):
    func set_double(self, T v) -> void:
        self.set_val(v)
Sub[int] s = Sub[int](0)
s.set_double(5)
print("v=" + (str)s.val)
print("DONE")
