# R5-04 回归面：组合轰炸（自引用+嵌套+容器+控制流）
# doc: docs/syntax/06_oop.md §6.4
# 期望: 组合场景不崩
import ai
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data
class Box[T]:
    T value
    func make(self, T v) -> Box[T]:
        return Box[T](v)

list[Node[int]] nodes = [Node[int](1), Node[int](2), Node[int](3)]
nodes[0].next = nodes[1]
nodes[1].next = nodes[2]
int total = 0
Node[int] cur = nodes[0]
while cur is not None:
    total = total + cur.get()
    cur = cur.next
print("total=" + (str)total)

Box[list[int]] bl = Box[list[int]]([])
Box[list[int]] bl2 = bl.make([10, 20])
print("len=" + (str)bl2.get().len())
print("DONE")
