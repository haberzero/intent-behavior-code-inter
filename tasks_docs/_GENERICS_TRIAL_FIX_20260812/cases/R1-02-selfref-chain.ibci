# R1-02 G2 自引用链遍历
# doc: docs/syntax/06_oop.md §6.4
# 期望: 多节点链遍历正确
import ai
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data

Node[int] head = Node[int](1)
Node[int] mid = Node[int](2)
Node[int] tail = Node[int](3)
head.next = mid
mid.next = tail
print("h=" + (str)head.get())
print("m=" + (str)head.next.get())
print("t=" + (str)head.next.next.get())
print("DONE")
