# R5-03 回归面：泛型 × 并发/生成器/闭包
# doc: docs/syntax/06_oop.md §6.4 + 14_concurrency + 05_functions
# 期望: 跨面泛型正常
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

chan[Box[int]] ch = chan(Box[int], "message")
ch.send(Box[int](5))
Box[int] from_chan = await ch.recv()
print("chan=" + (str)from_chan.get())

func gen_boxes() -> generator[Box[int]]:
    yield Box[int](1)
    yield Box[int](2)
int sum = 0
for Box[int] b in gen_boxes():
    sum = sum + b.get()
print("gen_sum=" + (str)sum)

fn_callable[int] add5 = lambda(int x) -> int: x + 5
Box[int] bb = Box[int](add5(10))
print("closure=" + (str)bb.get())
print("DONE")
