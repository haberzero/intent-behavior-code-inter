# R2-08 G1 生成器方法内 Box[T]（yield 自引用）
# doc: docs/syntax/06_oop.md §6.4 + 05_functions §5.8
# 期望: 生成器方法产出 Box[T] 实例
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value
    func gen(self, int n) -> generator[Box[T]]:
        int i = 0
        while i < n:
            yield Box[T](self.value)
            i = i + 1

Box[int] b = Box[int](5)
int count = 0
for Box[int] item in b.gen(3):
    count = count + item.get()
print("sum=" + (str)count)
print("DONE")
