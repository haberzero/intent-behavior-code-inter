# 入口类 -> Point __from_prompt__ 真实解析（module 感知，回归 S2 LLM 改造）
# doc: docs/syntax/06_oop.md
# expect-class: PASS
# expect-out: 42
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Point:
    int x
    func __init__(self, int x) -> auto:
        self.x = x
    func __from_prompt__(str raw) -> tuple:
        return (True, Point(42))
    func get(self) -> int:
        return self.x
Point p = @~ 返回点坐标 ~
print(p.get())
