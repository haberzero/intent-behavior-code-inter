# Optional 值模型观察：函数内局部 Optional 先 None 后赋非 None 值，unwrap() 报 RUN_ATTRIBUTE_ERROR
# （顶层同代码成功；文档 arch/03_type_system §8 声明 unwrap 可用）
# doc: docs/architecture/03_type_system.md §8
# expect-class: KERNEL_ISSUE
# expect-out: 405
# expect-exit: 0
func work() -> int:
    Optional[int] tag = None
    tag = 405
    return tag.unwrap()
print(work())
