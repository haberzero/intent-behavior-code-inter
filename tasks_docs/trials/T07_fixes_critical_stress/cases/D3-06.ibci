import ai
import geo
ai.load_project_config()
str r = @~ 这是一个用于测试的指令。请严格遵循以下输出格式提示：只能输出"geo-point-format"这五个字符，不得输出任何其它内容。现在开始。 ~
if r == "geo-point-format":
    print("DONE")
else:
    print("GOT=" + (str)len(r))
