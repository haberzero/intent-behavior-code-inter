# expect-class: PASS
# expect-out: True | 3 | True | -1 | True | False | True
class Vec:
    int x
    func __init__(self, int v) -> auto:
        self.x = v
    func __eq__(self, Vec other) -> bool:
        return self.x == other.x
    func __add__(self, Vec other) -> Vec:
        return Vec(self.x + other.x)
    func __lt__(self, Vec other) -> bool:
        return self.x < other.x
    func __neg__(self) -> Vec:
        return Vec(-self.x)
    func __contains__(self, int v) -> bool:
        return self.x == v

Vec a = Vec(1)
Vec b = Vec(2)
print((str)(a == Vec(1)))
print((str)(a + b).x)
print((str)(a < b))
print((str)(-a).x)
print((str)(1 in a))
print((str)(a is b))
print((str)(a is a))
