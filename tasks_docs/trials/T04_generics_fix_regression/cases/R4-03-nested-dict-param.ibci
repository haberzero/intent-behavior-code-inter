# R4-03 双通道 Box[dict[str,int]] 参数正/负
# doc: docs/syntax/06_oop.md §6.4
# 期望: 负例拦截，正例通过
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func set(self, T v) -> void:
        self.value = v
Box[dict[str, int]] bd = Box[dict[str, int]]({"a": 1})
bd.set({"b": 2})
print("key=" + (str)bd.value["b"])
print("DONE")
