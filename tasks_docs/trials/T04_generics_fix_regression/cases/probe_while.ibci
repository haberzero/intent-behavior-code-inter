import ai
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data
list[Node[int]] nodes = [Node[int](1), Node[int](2), Node[int](3)]
nodes[0].next = nodes[1]
nodes[1].next = nodes[2]
int total = 0
Node[int] cur = nodes[0]
while cur is not None:
    total = total + cur.get()
    cur = cur.next
print("total=" + (str)total)
print("DONE")
