# 自引用链 + 容器 + 控制流组合：固定次数遍历（Node[int] 非 Optional，None 哨兵不可行）
# doc: docs/syntax/06_oop.md §6.4
# 期望输出: total=6 / make=20 / DONE
# expect-class: PASS
# expect-out: total=6 | make=20 | DONE
# expect-exit: 0
import ai
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data
class Box[T]:
    T value
    func make(self, T v) -> Box[T]:
        return Box[T](v)

list[Node[int]] nodes = [Node[int](1), Node[int](2), Node[int](3)]
nodes[0].next = nodes[1]
nodes[1].next = nodes[2]
int total = 0
Node[int] cur = nodes[0]
int i = 0
while i < 3:
    total = total + cur.get()
    if i < 2:
        cur = cur.next
    i = i + 1
print("total=" + (str)total)

Box[int] bx = Box[int](10)
Box[int] bx2 = bx.make(20)
print("make=" + (str)bx2.value)
print("DONE")
