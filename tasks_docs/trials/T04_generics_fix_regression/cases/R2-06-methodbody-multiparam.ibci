# R2-06 G1 双类型参数 Pair[A,B] 方法体
# doc: docs/syntax/06_oop.md §6.4
# 期望: 多参数方法体内 A/B 各自解析
# expect-class: PASS
# expect-out: qk=2 | qv=k | DONE
# expect-exit: 0
import ai
ai.set_mock_mode()
class Pair[A, B]:
    A key
    B val
    func get_key(self) -> A:
        return self.key
    func get_val(self) -> B:
        return self.val
    func swap(self, B b) -> Pair[B, A]:
        return Pair[B, A](b, self.key)

Pair[str, int] p = Pair[str, int]("k", 1)
Pair[int, str] q = p.swap(2)
print("qk=" + (str)q.get_key())
print("qv=" + q.get_val())
print("DONE")
