# D2-01 泛型 × 运算符覆写
# doc: docs/syntax/06_oop.md §6.4 + docs/KNOWN_LIMITS.md §十四 #2
# 期望: 泛型类内运算符方法可用且特化后正常工作
# 核销: KERNEL_ISSUE-GEN-6 已修复（2026-08-13，解析端/构造端统一）
# expect-class: PASS
# expect-out: cx=4 | cy=6 | eq=True | neq=False | DONE
import ai
ai.set_mock_mode()
class Vec[T]:
    T x
    T y
    func __init__(self, T x, T y) -> void:
        self.x = x
        self.y = y
    func __add__(self, Vec[T] other) -> Vec[T]:
        return Vec[T](self.x + other.x, self.y + other.y)
    func __eq__(self, Vec[T] other) -> bool:
        return self.x == other.x and self.y == other.y

Vec[int] a = Vec[int](1, 2)
Vec[int] b = Vec[int](3, 4)
Vec[int] c = a + b
print("cx=" + (str)c.x)
print("cy=" + (str)c.y)
print("eq=" + (str)(a == Vec[int](1, 2)))
print("neq=" + (str)(a == b))
print("DONE")
