# D2-02 多级继承链泛型传递 Sub2[T](Sub1[T](Base[T]))
# doc: docs/syntax/06_oop.md §6.4
# 期望: 特化沿多级继承链传递
# expect-class: PASS
# expect-out: all=123 | DONE
# 2026-08-13 适配：G3 修复（chain-aware auto-init）后构造参数 = 全链无默认值字段
# （base_val, sub1_val, sub2_val 父先），`Sub2[int](0)` 单参不再成立 → 改多参构造。
import ai
ai.set_mock_mode()
class Base[T]:
    T base_val
    func get_base(self) -> T:
        return self.base_val

class Sub1[T](Base[T]):
    T sub1_val
    func get_sub1(self) -> T:
        return self.sub1_val

class Sub2[T](Sub1[T]):
    T sub2_val
    func get_sub2(self) -> T:
        return self.sub2_val
    func get_all(self) -> str:
        return (str)self.get_base() + (str)self.get_sub1() + (str)self.get_sub2()

Sub2[int] s = Sub2[int](1, 2, 3)
print("all=" + s.get_all())
print("DONE")
