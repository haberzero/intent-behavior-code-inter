# D2-04 泛型 × 容器（list[Box]/dict 值/tuple 内）
# doc: docs/syntax/06_oop.md §6.4
# 期望: 泛型实例作容器元素
# expect-class: PASS
# expect-out: m_a=1 | tp0=x | tp1=3 | joined=pq | DONE
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

dict[str, Box[int]] m = {"a": Box[int](1), "b": Box[int](2)}
print("m_a=" + (str)m["a"].get())
tuple[Box[str], Box[int]] tp = (Box[str]("x"), Box[int](3))
print("tp0=" + tp[0].get())
print("tp1=" + (str)tp[1].get())
list[Box[str]] ls = [Box[str]("p"), Box[str]("q")]
str joined = ls[0].get() + ls[1].get()
print("joined=" + joined)
print("DONE")
