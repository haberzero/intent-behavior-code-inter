# D3-04 恶意：递归特化 Node[Node[int]] / 自引用字段
# doc: docs/syntax/06_oop.md §6.4
# 期望: 递归特化工作或明确报错（不崩溃/不死循环）
# expect-class: PASS
# expect-out: n1=1 | next=2 | nested=1 | DONE
# Node[T] next 自引用字段带默认值
import ai
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data

Node[int] n1 = Node[int](1)
n1.next = Node[int](2)
print("n1=" + (str)n1.get())
print("next=" + (str)n1.next.get())
Node[Node[int]] nn = Node[Node[int]](n1)
print("nested=" + (str)nn.get().get())
print("DONE")
