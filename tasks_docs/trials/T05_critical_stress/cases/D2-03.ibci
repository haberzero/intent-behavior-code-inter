# Optional None 流：is None 对 Optional 包装的 None 语义（KI-2 修复后核销：a is None=True / b is None=True / a.is_some()=False）
# doc: docs/syntax/03_operators.md 70（x is None 判断是否为 None）
# expect-class: PASS
# expect-out: True | True | False
# expect-exit: 0
Optional[int] a = None
any b = None
print(a is None)
print(b is None)
print(a.is_some())
