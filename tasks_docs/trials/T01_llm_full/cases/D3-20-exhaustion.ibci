# D3-20 对抗：llmexcept retry 收敛压力（硬约束 + 长文本）
# 期望: 连续不确定输入下 retry 有限次数收敛；或耗尽后 LLMRetryExhaustedError 可捕获

import ai
ai.set_retry(3)

try:
    int n = @~ 请用汉字书写一个极大数：一万亿零三 ~
    llmexcept:
        retry "请务必只返回一个纯阿拉伯数字整数，无任何文字"
    print("n=" + (str)n)
except LLMRetryExhaustedError as e:
    print("exhausted=" + e.message)
except LLMError as e:
    print("llm_err=" + e.message)
except Exception as e:
    print("gen_err=" + (str)e)
print("DONE")
