# D1-05-008 yield 惰性生成器（含 LLM 组合）
# doc: docs/syntax/05_functions.md §5.8
# 期望: 生成器逐值产出；体内 LLM 挂起可组合

# expect-class: PASS
# expect-out: gen_type=generator[str] | items_len=3 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
func greetings(int n) -> str:
    int i = 0
    while i < n:
        str g = @~ 用一句话介绍中国的美食，不超过15字 ~
        yield g
        i = i + 1
    return "done"

for str g in greetings(2):
    print("g=" + g)

auto gen = greetings(3)
print("gen_type=" + type(gen))
list items = gen.to_list()
print("items_len=" + (str)items.len())
print("DONE")
