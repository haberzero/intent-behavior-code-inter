# D3-C3d 真实 LLM 超时 + try/except，变量在 try 内读取
# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()

ai.set_timeout(0.01)
ai.set_retry(1)

try:
    str r = @~ 请写一篇500字作文 ~
    print("inner_len=" + (str)r.len())
except LLMCallError as e:
    print("caught_llmcall=" + e.message)
except LLMError as e:
    print("caught_llm=" + e.message)
except Exception as e:
    print("caught_gen=" + (str)e)
print("DONE")
