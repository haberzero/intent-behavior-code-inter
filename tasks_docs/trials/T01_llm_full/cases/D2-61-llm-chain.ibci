# D2-61 多层次：LLM 函数链（A→B→C 三级调用）+ 参数传递
# doc: docs/syntax/08_llm_functions.md §8.1-8.2
# 期望: 三级 LLM 函数串联正常

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
llm 提炼(str text) -> str:
__sys__
你是摘要专家。
__user__
把 "$text" 提炼成一句话。
llmend

llm 扩写(str text) -> str:
__sys__
你是润色专家。
__user__
把 "$text" 扩写成三句话。
llmend

llm 翻译2(str text) -> str:
__sys__
你是翻译。
__user__
把 "$text" 翻译成英文。
llmend

str s1 = 提炼("量子计算和人工智能正在改变世界")
print("s1=" + s1)
str s2 = 扩写(s1)
print("s2=" + s2)
str s3 = 翻译2(s2)
print("s3=" + s3)
print("DONE")
