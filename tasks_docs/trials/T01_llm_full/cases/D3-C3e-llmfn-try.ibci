# D3-C3e LLM 函数 + provider 超时 + try/except 捕获（确认路径通用性）
# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()

ai.set_timeout(0.01)
ai.set_retry(1)

llm 写作文(str topic) -> str:
__sys__
你是作家。
__user__
写一篇关于 $topic 的500字作文。
llmend

try:
    str r = 写作文("秋天")
    print("inner_len=" + (str)r.len())
except LLMCallError as e:
    print("caught_llmcall=" + e.message)
except LLMError as e:
    print("caught_llm=" + e.message)
except Exception as e:
    print("caught_gen=" + (str)e)
print("DONE")
