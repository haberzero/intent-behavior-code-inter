# D1-11-001 模块 import / isys / idbg / ai 内省（A4 重验）
# doc: docs/syntax/11_modules.md §11.1/§11.3-11.5
# 期望: import 顶部约束；isys 路径；idbg 调用信息在 dispatch 赋值后立即可观测（d6d28e1）

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
import isys
import idbg

str entry = isys.entry_path()
str dirp = isys.entry_dir()
print("entry_ok=" + (str)entry.len())
print("dir_ok=" + (str)dirp.len())

int x = 42
idbg.print_vars()
dict vars_map = idbg.vars()
print("vars_ok=" + (str)vars_map.contains("x"))

str greeting = @~ 打个招呼，简短 ~
dict info = idbg.current_llm()
print("info_keys=" + (str)info.keys())
print("has_prompt=" + (str)info.contains("prompt"))
print("greeting=" + greeting)
print("DONE")
