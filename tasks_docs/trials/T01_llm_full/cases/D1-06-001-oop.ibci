# D1-06-001 类定义/继承/super/协议 __call__/__iter__/__to_prompt__/__from_prompt__
# doc: docs/syntax/06_oop.md §6.1-6.4/§6.6 + 07_behavior_expressions.md §7.4
# 期望: 类与继承正确；协议方法在 LLM 路径生效

class Point:
    int x
    int y
    func __init__(self, int x, int y) -> auto:
        self.x = x
        self.y = y
    func distance(self) -> float:
        return (float)(self.x * self.x + self.y * self.y)

Point p = Point(3, 4)
print("dist=" + (str)p.distance())

class Animal:
    str name
    func __init__(self, str name) -> auto:
        self.name = name
    func speak(self) -> str:
        return self.name + " says something"

class Dog(Animal):
    func __init__(self, str n) -> auto:
        super().__init__(n)
    func speak(self) -> str:
        return self.name + " says Woof!"

Dog d = Dog("Rex")
print("speak=" + d.speak())

class Greeter:
    str name
    func __init__(self, str name) -> auto:
        self.name = name
    func __to_prompt__(self) -> str:
        return "名字是" + self.name
    func greet(self) -> str:
        str g = @~ $self 打个招呼 ~
        return g

Greeter g2 = Greeter("小明")
print("greet=" + g2.greet())
print("DONE")
