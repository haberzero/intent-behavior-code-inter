# D2-34 多可能性：无保护裸 LLM 解析失败 → LLMParseError
# doc: docs/syntax/10_robustness.md §10.3 + 04_control_flow.md §4.7
# 期望: 无 llmexcept 时解析失败抛 LLMParseError，可被 try/except 捕获

try:
    int n = @~ 返回一个非常大的数字，大于普通整数范围 ~
    print("n=" + (str)n)
except LLMParseError as e:
    print("parse_err=" + e.message)
except LLMError as e:
    print("llm_err=" + e.message)
except Exception as e:
    print("gen_err=" + e.message)
print("DONE")
