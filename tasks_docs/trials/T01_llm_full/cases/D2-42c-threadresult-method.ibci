# D2-42c 多可能性：thread_result `.value()` 方法形态（syntax doc §14.7）
# expect-class: PASS
# expect-out: value_method=42 | DONE
# expect-exit: 0
# expect-llm: false
func fetch(int x) -> int:
    return x * 2

thread[int] t = thread(callable=fetch, args=[21])
thread_result[int] r = t.join()
print("value_method=" + (str)r.value())
print("DONE")
