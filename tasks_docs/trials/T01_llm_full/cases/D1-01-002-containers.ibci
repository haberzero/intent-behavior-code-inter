# D1-01-002 泛型容器 list[int]/dict[str,int] + Optional[T]
# doc: docs/syntax/01_types.md §1.2/§1.3.1
# 期望: 泛型容器正确赋值访问；Optional 空安全 API 正确

# expect-class: PASS
# expect-out: first=1 | n=b | alice=95 | or_else=0 | unwrap=1 | is_some=True
# expect-exit: 0
# expect-llm: false
list[int] nums = [1, 2, 3]
list[str] names = ["a", "b"]
dict[str, int] scores = {"Alice": 95}

int first = nums[0]
str n = names[1]
int alice = scores["Alice"]

print("first=" + (str)first)
print("n=" + n)
print("alice=" + (str)alice)

Optional[int] maybe_a = None
Optional[int] maybe_b = 1
int a = maybe_a.or_else(0)
int b = maybe_b.unwrap()
bool ok = maybe_b.is_some()

print("or_else=" + (str)a)
print("unwrap=" + (str)b)
print("is_some=" + (str)ok)
print("DONE")
