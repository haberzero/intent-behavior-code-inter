# D3-C4 并发扩展：run_batch 多路 + 多任务并发（C4）
# doc: _REAL_LLM_E2E_RESTART.md C4（原只测 2 路）
# 期望: 8 路 run_batch + 4 线程并发，全部正确返回无竞态

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()

fn classify = lambda(str w) -> str: @~ 用两个字归类：$w ~
list words = ["苹果", "香蕉", "橙子", "葡萄", "西瓜", "草莓", "蓝莓", "猕猴桃"]
list results = ai.run_batch(classify, words)
print("batch8=" + (str)results.len())
for any item in results:
    print("c=" + (str)item)

chan ch = chan(str, "stream")
func w(int n) -> void:
    str r = @~ 用一句话介绍数字 $n ~
    ch.send(r)

thread[void] t1 = thread(callable=w, args=[1])
thread[void] t2 = thread(callable=w, args=[2])
thread[void] t3 = thread(callable=w, args=[3])
thread[void] t4 = thread(callable=w, args=[4])
t1.join()
t2.join()
t3.join()
t4.join()
str m1 = ch.recv()
str m2 = ch.recv()
str m3 = ch.recv()
str m4 = ch.recv()
print("thread4=" + (str)m1.len() + (str)m2.len() + (str)m3.len() + (str)m4.len())
print("DONE")
