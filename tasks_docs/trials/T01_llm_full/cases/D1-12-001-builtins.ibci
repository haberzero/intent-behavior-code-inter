# D1-12-001 内建转换 + 序列辅助 + str/list/dict 方法
# doc: docs/syntax/12_builtins.md §12.1-12.5
# 期望: 内建转换与序列辅助正确；方法正确

# expect-class: PASS
# expect-out: conv=42423.5True | en=0a | en=1b | sorted=123 | reversed=213 | sum=6
# expect-exit: 0
# expect-llm: false
int a = int("42")
str b = str(42)
float c = float("3.5")
bool d = bool(1)
print("conv=" + (str)a + b + (str)c + (str)d)

list[str] names = ["a", "b"]
for (int i, str name) in enumerate(names):
    print("en=" + (str)i + name)

list[int] l = [3, 1, 2]
list[int] s = sorted(l)
print("sorted=" + (str)s[0] + (str)s[1] + (str)s[2])
list[int] r = reversed(l)
print("reversed=" + (str)r[0] + (str)r[1] + (str)r[2])

list[int] nums = [1, 2, 3]
print("sum=" + (str)sum(nums))
print("max=" + (str)max(nums))
print("min=" + (str)min(nums))
print("max2=" + (str)max(3, 1, 2))
list[bool] flags = [True, False]
print("all=" + (str)all(flags))

str s2 = "  Hello World  "
print("strip=" + s2.strip())
print("upper=" + s2.upper())
print("split=" + (str)s2.split(" "))
print("contains=" + (str)s2.contains("World"))

list[int] l2 = [3, 1, 2]
l2.append(4)
l2.insert(0, 99)
l2.remove(99)
l2.sort()
print("list=" + (str)l2[0] + (str)l2[1] + (str)l2[2] + (str)l2[3])

dict[str,int] dd = {"a": 1, "b": 2}
dd["c"] = 3
int v = dd["a"]
bool has = "a" in dd
print("dict=" + (str)v + (str)has + (str)dd.len())

tuple t = (1, "hello", True)
auto first = t[0]
print("tuple=" + (str)first + (str)t.len())
print("DONE")
