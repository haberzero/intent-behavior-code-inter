# D1-09-001 意图 @ 一次性 smear + @! 排他 override + @+ 持久（A1 重验）
# doc: docs/syntax/09_intent_system.md §9.1/§9.2
# 期望: 意图真实进入 prompt；赋值路径生效

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
@ 用冷酷无感情且极简的口吻回复，只回两个字
str r1 = @~ 打个招呼 ~
print("r1=" + r1)

@! 只输出：YES 或 NO，不要任何其他内容
bool b1 = @~ 1+1=2 吗 ~
print("b1=" + (str)b1)

str r2 = @~ 打个招呼 ~
print("r2=" + r2)

@+ 回答要简短，不超过10字
str a1 = @~ 描述一下天空 ~
str a2 = @~ 描述一下海洋 ~
@-
str a3 = @~ 描述一下天空 ~
print("a1=" + a1)
print("a2=" + a2)
print("a3=" + a3)
print("DONE")
