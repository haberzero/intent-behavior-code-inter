# D1-07-005 ai.run_batch 批量并发（A5 重验 + C4 并发扩展）
# doc: docs/syntax/07_behavior_expressions.md §7.4 批量并发
# 期望: run_batch 并发执行保序返回；结果可观测

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()

fn summarize = lambda(str doc) -> str: @~ 用一句话总结：$doc ~
list docs = ["苹果", "香蕉", "橙子"]

list results = ai.run_batch(summarize, docs)
print("batch_len=" + (str)results.len())

dict info = ai.get_current_call_info()
print("info_keys=" + (str)info.keys())
for any item in results:
    print("item=" + (str)item)
print("DONE")
