# D1-05-003b 深递归到环境限制边界（KNOWN_LIMITS §二十三）
# doc: docs/KNOWN_LIMITS.md §二十三（~980 层作用域链解析触发宿主 RecursionError，
#   环境限制异常根因保留，不被包装成语义错误）
# 期望: 深递归（如 2000 层）触发 RecursionError 根因（或正常完成）；不被包装为
#   "Symbol not defined"/"VM: Call failed" 语义错误；KDIAG_RUNTIME_ENV_LIMIT

func deep(int n) -> int:
    if n <= 0:
        return 0
    return deep(n - 1)

int r = deep(2000)
print("deep_ok=" + (str)r)
print("DONE")
