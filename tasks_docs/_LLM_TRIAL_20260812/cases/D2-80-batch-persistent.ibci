# D2-80 正交：@+ 持久意图 + run_batch（意图跨批注入）
# doc: docs/syntax/09_intent_system.md §9.2（@+ 影响后续所有 LLM 调用）
# 期望: run_batch 各行为都收到 @+ 持久意图

import ai

@+ 回复必须只用一个字
fn q = lambda(str word) -> str: @~ 用一字形容 $word ~
list res = ai.run_batch(q, ["苹果", "太阳"])
for any item in res:
    print("item=" + (str)item)
@-
print("DONE")
