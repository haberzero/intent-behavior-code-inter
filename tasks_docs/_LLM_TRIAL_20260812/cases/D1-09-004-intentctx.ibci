# D1-09-004 intent_context 实例 push/pop/use
# doc: docs/syntax/09_intent_system.md §9.3 + KNOWN_LIMITS §十二
# 期望: ctx 实例 push/pop/use 影响当前作用域意图（须 use 生效）

import ai

intent_context ctx = intent_context.get_current()
ctx.push("请用简洁的语言回答，不超过10字")
intent_context.use(ctx)
str r1 = @~ 描述天空 ~
ctx.pop()
intent_context.use(ctx)

ctx.push("用详细专业的语言回答")
intent_context.use(ctx)
str r2 = @~ 描述天空 ~
ctx.pop()
intent_context.use(ctx)

print("r1=" + r1)
print("r2=" + r2)
print("DONE")
