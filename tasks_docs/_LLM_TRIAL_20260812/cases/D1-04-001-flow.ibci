# D1-04-001 if/elif/else + for range + break/continue
# doc: docs/syntax/04_control_flow.md §4.1/§4.3/§4.4
# 期望: 控制流正确执行；break/continue 语义正确

int x = 10
if x > 5:
    print("gt5")
elif x == 5:
    print("eq5")
else:
    print("lt5")

list[str] names = ["Alice", "Bob", "Charlie"]
for str name in names:
    print("name=" + name)

for int i in range(5):
    print("r=" + (str)i)

for int i in range(0, 10, 2):
    print("step=" + (str)i)

for int i in range(10):
    if i == 5:
        break
    if i % 2 == 0:
        continue
    print("bc=" + (str)i)
print("DONE")
