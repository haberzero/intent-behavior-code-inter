# D3-30 意图：@- #tag 标签移除 + 全局意图 set_global_intent
# doc: docs/syntax/09_intent_system.md §9.1 + 11_modules §11.3 ai.set_global_intent
# 期望: 标签意图移除正确；全局意图注入影响真实 LLM

import ai

ai.set_global_intent("回复时必须以'注：'开头")
str r1 = @~ 打个招呼 ~
print("r1=" + r1)

ai.clear_global_intents()
str r2 = @~ 打个招呼 ~
print("r2=" + r2)

@+ 极简回复 #minimal
str a1 = @~ 描述天空 ~
@- #minimal
str a2 = @~ 描述天空 ~
print("a1=" + a1)
print("a2=" + a2)
print("DONE")
