# D1-05-006 lambda 延迟执行（调用时意图敏感）
# doc: docs/syntax/07_behavior_expressions.md §7.4 + 05_functions.md §5.5
# 期望: lambda 定义时不调用 LLM；调用时触发；带参数 lambda；-> auto 行为体=str

fn compute = lambda -> int: @~ 1+1 等于几？只答数字 ~
print("defined_no_call")   # 此时不应有 LLM 调用
int result = compute()
print("result=" + (str)result)

fn translate = lambda(str text) -> str: @~ 翻译 $text 为中文 ~
str r = translate("hello")
print("r=" + r)

fn add = lambda(int a, int b) -> int: a + b
print("add=" + (str)add(3, 4))

fn g = lambda -> auto: @~ 给出一个数字 ~
str gv = g()
print("g_type=" + type(gv))
print("DONE")
