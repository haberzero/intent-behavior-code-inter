# D1-01-003 类型转换 + None 语义
# doc: docs/syntax/01_types.md §1.4/§1.3
# 期望: (str)x / (float)42 / (bool)1 / (any)x 正确；(str)None = "None"；None 布尔假

int x = 42
str s = (str)x
float fl = (float)42
bool bb = (bool)1
any a = (any)x

print("s=" + s)
print("fl=" + (str)fl)
print("bb=" + (str)bb)
print("a_ok=" + (str)(a == 42))

str ns = (str)None
print("none_str=" + ns)

any none_val = None
if none_val:
    print("none_is_truthy")
else:
    print("none_is_false")
print("DONE")
