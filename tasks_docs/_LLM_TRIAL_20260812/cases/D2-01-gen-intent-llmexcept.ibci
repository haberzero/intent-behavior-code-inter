# D2-01 交叉：生成器 + LLM + 意图 + llmexcept 四正交组合
# 期望: 生成器体内挂起 LLM，且意图/llmexcept 在生成器多次恢复间正确保持

@+ 回复要极简，不超过8字
func gen(int n) -> str:
    int i = 0
    while i < n:
        int v = @~ 1 加 $i 等于几？只答数字 ~
        llmexcept:
            retry "请只返回一个整数"
        yield (str)v
        i = i + 1
    return "end"
@-

for str x in gen(3):
    print("yield=" + x)
print("DONE")
