# D1-10-001 llmexcept + retry 收敛 + llmretry 语法糖
# doc: docs/syntax/10_robustness.md §10.1-10.2
# 期望: retry 引导 LLM 正确格式；重试收敛

int result = @~ 1+1 等于几？只答数字 ~
llmexcept:
    print("retrying...")
    retry "请务必只返回一个纯数字"

print("result=" + (str)result)

str res = @~ 判断当前状态，只回答正常或异常 ~
llmretry "如果无法判断，请回复 0 并说明原因"

print("res_len=" + (str)res.len())
print("DONE")
