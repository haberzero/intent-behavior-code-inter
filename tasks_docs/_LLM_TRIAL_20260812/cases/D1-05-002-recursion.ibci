# D1-05-002 递归 + 嵌套函数 + fn 引用 + fn 高阶签名 + callable 内省
# doc: docs/syntax/05_functions.md §5.3/§5.4/§5.5/§5.6/§5.7
# 期望: 递归/嵌套/fn 引用正确；type(f)/__return_type__() 返回签名形态

func factorial(int n) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

print("fac5=" + (str)factorial(5))

func outer(int x) -> int:
    func inner(int y) -> int:
        return y * 2
    return inner(x) + 1

print("outer=" + (str)outer(3))

func double(int x) -> int:
    return x * 2

fn f = double
print("fn_ref=" + (str)f(5))

fn g = lambda -> auto: 42
print("fn_lambda=" + (str)g())

func apply(fn[(int, str) -> bool] predicate, int x, str s) -> bool:
    return predicate(x, s)

fn pred = lambda(int a, str b) -> bool: True
print("higher=" + (str)apply(pred, 1, "x"))

fn h = lambda(int x, str y) -> bool: True
str sig = type(h)
str ret = h.__return_type__()
print("sig=" + sig)
print("ret=" + ret)
print("DONE")
