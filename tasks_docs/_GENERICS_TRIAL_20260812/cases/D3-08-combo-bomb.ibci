# D3-08 恶意：组合轰炸（嵌套特化 + 多级继承 + 容器 + 控制流 + 并发）
# doc: docs/syntax/06_oop.md §6.4
# 期望: 组合场景不崩溃（尽力正确）
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

class Pair[K, V]:
    K key
    V val
    func get_key(self) -> K:
        return self.key
    func get_val(self) -> V:
        return self.val

list[Pair[str, Box[int]]] items = [Pair[str, Box[int]]("a", Box[int](1)), Pair[str, Box[int]]("b", Box[int](2))]
int total = 0
for Pair[str, Box[int]] p in items:
    total = total + p.get_val().get()
print("total=" + (str)total)
dict[str, Box[list[int]]] m = {"x": Box[list[int]]([1, 2])}
print("m_len=" + (str)m["x"].get().len())
print("DONE")
