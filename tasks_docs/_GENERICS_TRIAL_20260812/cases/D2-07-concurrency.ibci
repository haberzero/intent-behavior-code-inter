# D2-07 泛型 × 并发（thread 内构造泛型类 / chan 传泛型 / slot 存泛型）
# doc: docs/syntax/06_oop.md §6.4 + 14_concurrency
# 期望: 泛型实例跨并发面工作
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

chan[Box[int]] ch = chan(Box[int], "message")
ch.send(Box[int](5))
Box[int] from_chan = await ch.recv()
print("chan=" + (str)from_chan.get())

func make_box() -> Box[str]:
    return Box[str]("in_thread")

thread[Box[str]] th = thread(callable=make_box, args=[])
thread_result[Box[str]] r = await th
Optional[Box[str]] maybe = r.unwrap()
Box[str] from_thread = maybe.unwrap()
print("thread=" + from_thread.get())

slot[Box[int]] sl = slot("s1", Box[int](9))
Box[int] from_slot = sl.get()
print("slot=" + (str)from_slot.get())
print("DONE")
