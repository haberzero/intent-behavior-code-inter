# D2-09 泛型 × 行为/LLM 面（mock：@~ 返回初始化泛型字段 / llmexcept 保护泛型）
# doc: docs/syntax/06_oop.md §6.4 + 09_intent_system + KNOWN_LIMITS
# 期望: 泛型类字段可经 LLM 赋值；llmexcept 保护泛型实例状态
import ai
ai.set_mock_mode()
class Score[T]:
    T value
    func get(self) -> T:
        return self.value

Score[int] s = Score[int](0)
s.value = @~ MOCK:STR:42 ~
print("llm_val=" + (str)s.get())

Score[str] st = Score[str]("a")
try:
    st.value = @~ MOCK:FAIL force_error ~
except:
    print("caught_llm_error")
print("after_except=" + st.get())
print("DONE")
