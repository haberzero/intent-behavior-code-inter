# D2-10 泛型 × 闭包（lambda 闭包捕获 / lambda 调泛型方法）
# doc: docs/syntax/06_oop.md §6.4 + 05_functions §5.5
# 期望: lambda 闭包捕获 + 调用泛型方法
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

fn_callable[int] add5 = lambda(int x) -> int: x + 5
int r1 = add5(10)
print("r1=" + (str)r1)

Box[int] bi = Box[int](42)
fn_callable[int] getter = lambda -> int: bi.get()
int r2 = getter()
print("r2=" + (str)r2)
print("DONE")
