# T10-M6 __retry__ 调用级策略 + MOCK:REPAIR：首轮修复哨兵触发重试，次轮成功
# doc: docs/syntax/08_llm_callable.md §8.4
# expect-class: PASS
# expect-out: val=1 | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
class 重试器:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "MOCK:REPAIR", "expected_type": "int"}
    func __retry__(self) -> dict:
        return {"max_retry": 3}
重试器 r = 重试器()
int v = r()
print("val=" + (str)v)
print("DONE")
