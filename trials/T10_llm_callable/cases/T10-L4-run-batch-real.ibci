# T10-L4 真实 LLM：run_batch 逐项独立调用（llm 可调用实例）
# doc: docs/syntax/08_llm_callable.md §8.3
# expect-class: PASS
# expect-out: got_two=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 编号:
    func __llm_call__(self, any item) -> dict:
        return {"user_prompt": "只返回数字 " + str(item), "prompt_slots": [{"kind": "user_sys", "text": "你只返回数字本身，不要任何其它内容。"}], "expected_type": "int"}
编号 n = 编号()
list results = ai.run_batch(n, [1, 2])
print("got_two=" + (str)((int)results[1] == 2))
print("DONE")
