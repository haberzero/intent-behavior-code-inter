# T10-M1 llm 可调用类定义 + 直接调用（参数按位绑定 + prompt_slots 自定义槽 + expected_type str）
# doc: docs/syntax/08_llm_callable.md §8.1-8.2
# expect-class: PASS
# expect-out: echo=hello-world | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
class 回显:
    func __llm_call__(self, any 前, any 后) -> dict:
        return {"user_prompt": "MOCK:STR:\"" + str(前) + "-" + str(后) + "\"", "prompt_slots": [{"kind": "user_sys", "text": "你是一个回显器。"}]}
回显 e = 回显()
str v = e("hello", "world")
print("echo=" + v)
print("DONE")
