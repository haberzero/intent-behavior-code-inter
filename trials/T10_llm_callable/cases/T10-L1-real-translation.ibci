# T10-L1 真实 LLM：llm 可调用类直接调用 + prompt_slots 角色 + 参数绑定（真实翻译）
# doc: docs/syntax/08_llm_callable.md §8.1-8.2
# expect-class: PASS
# expect-out: translated_len_gt0=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 翻译:
    func __llm_call__(self, any 文本, any 目标语言) -> dict:
        return {"user_prompt": "请将 \"" + str(文本) + "\" 翻译为 " + str(目标语言) + "。", "prompt_slots": [{"kind": "user_sys", "text": "你是一个专业翻译，直接输出翻译结果，不加任何解释。"}]}
翻译 t = 翻译()
str result = t("Hello World", "中文")
print("translated_len_gt0=" + (str)(result.len() > 0))
print("DONE")
