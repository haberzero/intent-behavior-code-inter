import ai
ai.set_mock_mode()
class 回显:
    func __llm_call__(self, any 前) -> dict:
        return {"user_prompt": "MOCK:STR:hi", "user_promt_typo": "extra"}
回显 e = 回显()
str v = e("a")
print("got=" + v)
