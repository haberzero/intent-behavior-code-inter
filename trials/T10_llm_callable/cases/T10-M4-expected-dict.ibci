# T10-M4 expected_type dict[str,int] 容器解析（MOCK:DICT）
# doc: docs/syntax/08_llm_callable.md §8.5
# expect-class: PASS
# expect-out: a=1 b=2 | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
class 取表:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "MOCK:DICT:{\"a\":1,\"b\":2}", "expected_type": "dict[str,int]"}
取表 q = 取表()
dict[str,int] d = q()
print("a=" + (str)d["a"] + " b=" + (str)d["b"])
print("DONE")
