# T10-M7 __retry__ 调用级策略耗尽 + MOCK:FAIL：结果交语句层捕获（LLMParseError）
# doc: docs/syntax/08_llm_callable.md §8.4
# expect-class: PASS
# expect-out: caught=True | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
class 全败:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "MOCK:FAIL", "expected_type": "int"}
    func __retry__(self) -> dict:
        return {"max_retry": 2}
全败 f = 全败()
try:
    int v = f()
    print("unexpected=" + (str)v)
except LLMParseError as e:
    print("caught=True")
except Exception as e:
    print("caught_gen=" + (str)e)
print("DONE")
