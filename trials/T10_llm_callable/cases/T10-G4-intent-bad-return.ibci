# T10-G4 __intent__ 返回非 dict（契约违约 fail-fast）
# doc: docs/syntax/08_llm_callable.md §8.4
# expect-class: GUARD
# expect-code: RUN_LLM_CALLABLE
# expect-exit: nonzero
# expect-llm: false
import ai
ai.set_mock_mode()
class 坏:
    func __intent__(self, dict intents) -> str:
        return "bad"
    func __llm_call__(self) -> dict:
        return {"user_prompt": "MOCK:STR:\"x\""}
坏 b = 坏()
str v = b()
print("DONE")
