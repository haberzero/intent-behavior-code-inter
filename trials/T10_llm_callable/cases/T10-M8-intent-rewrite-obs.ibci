# T10-M8 __intent__ 三层改写：读入 global 层改写 merged（经 idbg.show_target_prompt 观测注入）
# doc: docs/syntax/08_llm_callable.md §8.4
# expect-class: PASS
# expect-out: - 改写自:全局意图 | DONE
# expect-exit: 0
# expect-llm: false
import ai
import idbg
ai.set_mock_mode()
ai.set_global_intent("全局意图")
class 改写:
    func __intent__(self, dict intents) -> dict:
        return {"merged": ["改写自:" + intents["global"][0]]}
    func __llm_call__(self) -> dict:
        return {"user_prompt": "MOCK:STR:\"ok\""}
改写 w = 改写()
str v = w()
idbg.show_target_prompt()
print("DONE")
