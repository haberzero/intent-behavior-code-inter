# D1-08-001 llm 可调用类定义/调用/prompt_slots 自定义槽/参数插值（llm 函数 → llm 可调用类；__llmretry__ 段语义迁 __retry__ 协议）
# doc: docs/syntax/09_llm.md
# 期望: 翻译调用返回真实翻译

# expect-class: PASS
# expect-out: parsed=12 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 翻译:
    func __llm_call__(self, any 文本, any 目标语言) -> dict:
        return {"user_prompt": "请将 \"" + str(文本) + "\" 翻译为 " + str(目标语言) + "。", "prompt_slots": [{"kind": "user_sys", "text": "你是一个专业翻译，直接输出翻译结果，不加任何解释。"}]}

翻译 t = 翻译()
str result = t("Hello World", "中文")
print("translated=" + result)

class 解析数字:
    func __llm_call__(self, any 文本) -> dict:
        return {"user_prompt": "从 \"" + str(文本) + "\" 中提取一个整数，只返回数字本身。", "prompt_slots": [{"kind": "user_sys", "text": "你是一个数字提取专家。"}], "expected_type": "int"}

解析数字 p = 解析数字()
int n = p("今年有12个月")
print("parsed=" + (str)n)
print("DONE")