# D2-60 多层次：闭包 + 生成器 + LLM 组合（三层宿主）
# doc: docs/syntax/05_functions.md §5.4/§5.8 + docs/syntax/07_behavior_expressions.md §7.1
# 期望: 闭包工厂返回生成器函数，体内 LLM 组合正常

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
func make_gen(str prefix) -> fn:
    func gen(int n) -> str:
        int i = 0
        while i < n:
            str v = @~ 用 $prefix 造一个词，不超过5字 ~
            yield prefix + v
            i = i + 1
        return "end"
    return gen

fn g = make_gen("Q")
for str x in g(2):
    print("x=" + x)
print("DONE")
