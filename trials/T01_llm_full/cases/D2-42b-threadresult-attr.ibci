# D2-42b thread_result `.value()` 调用形态（howto 写法，docs/howto/write_concurrent_tasks.md）
# expect-class: PASS
# expect-out: value=42 | DONE
# expect-exit: 0
# expect-llm: false
func fetch(int x) -> int:
    return x * 2

thread[int] t = thread(callable=fetch, args=[21])
thread_result[int] r = t.join()
int v = r.value()
print("value=" + (str)v)
print("DONE")
