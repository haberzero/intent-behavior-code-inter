# D1-02-002 元组解包 + 多重赋值交换
# doc: docs/syntax/02_variables.md §2.4/§2.5
# 期望: 元组解包正确；(a,b)=(b,a) 交换

# expect-class: PASS
# expect-out: a=10 b=20 | xyz=pqr | after_swap a2=2 b2=1 | DONE
# expect-exit: 0
# expect-llm: false
(int a, int b) = (10, 20)
(str x, str y, str z) = ("p", "q", "r")

print("a=" + (str)a + " b=" + (str)b)
print("xyz=" + x + y + z)

int a2 = 1
int b2 = 2
(a2, b2) = (b2, a2)
print("after_swap a2=" + (str)a2 + " b2=" + (str)b2)
print("DONE")
