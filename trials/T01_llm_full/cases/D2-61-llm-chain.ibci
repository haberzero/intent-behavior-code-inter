# D2-61 多层次：llm 可调用类链（A→B→C 三级调用）+ 参数传递（P4c 迁移：llm 函数 → llm 可调用类）
# doc: docs/syntax/09_llm.md
# 期望: 三级 llm 可调用类串联正常

# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 提炼:
    func __llm_call__(self, any text) -> dict:
        return {"user_prompt": "把 \"" + str(text) + "\" 提炼成一句话。", "prompt_slots": [{"kind": "user_sys", "text": "你是摘要专家。"}]}

class 扩写:
    func __llm_call__(self, any text) -> dict:
        return {"user_prompt": "把 \"" + str(text) + "\" 扩写成三句话。", "prompt_slots": [{"kind": "user_sys", "text": "你是润色专家。"}]}

class 翻译2:
    func __llm_call__(self, any text) -> dict:
        return {"user_prompt": "把 \"" + str(text) + "\" 翻译成英文。", "prompt_slots": [{"kind": "user_sys", "text": "你是翻译。"}]}

提炼 a1 = 提炼()
str s1 = a1("量子计算和人工智能正在改变世界")
print("s1=" + s1)
扩写 a2 = 扩写()
str s2 = a2(s1)
print("s2=" + s2)
翻译2 a3 = 翻译2()
str s3 = a3(s2)
print("s3=" + s3)
print("DONE")