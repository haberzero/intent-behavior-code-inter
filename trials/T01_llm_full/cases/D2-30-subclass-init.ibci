# 子类 auto-init 继承链字段绑定（父类字段 + 自身字段，全链无默认值字段）
# doc: docs/syntax/06_oop.md §6.4
# 期望: Dog 构造参数 = name + breed（父类优先），父类字段不再静默 None
# expect-class: PASS
# expect-out: breed=Lab | name_null=False | DONE
# expect-exit: 0
# expect-llm: false
class Animal:
    str name

class Dog(Animal):
    str breed

Dog d = Dog("Husky", "Lab")
print("breed=" + d.breed)
print("name_null=" + (str)(d.name == None))
print("DONE")
