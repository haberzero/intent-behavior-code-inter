# D1-03-002 比较/逻辑/成员/身份 + 三元
# doc: docs/syntax/03_operators.md §3.2-§3.5 + docs/syntax/04_control_flow.md §4.1
# 期望: 各运算符正确；三元两种风格正确

# expect-class: PASS
# expect-out: cmp=TrueTrueTrue | logic=FalseTrueFalse | membership=TrueTrueTrue | identity=TrueFalse | ternary=11 | DONE
# expect-exit: 0
# expect-llm: false
bool cmp1 = "apple" < "banana"
bool cmp2 = 3 <= 3
bool cmp3 = 5 > 2

bool r1 = True and False
bool r2 = True or False
bool r3 = not True

bool b1 = 3 in [1, 2, 3]
bool b2 = "x" not in ["a", "b"]
bool b3 = "key" in {"key": 1}

any none_v = None
bool id1 = none_v is None
bool id2 = none_v is not None

print("cmp=" + (str)cmp1 + (str)cmp2 + (str)cmp3)
print("logic=" + (str)r1 + (str)r2 + (str)r3)
print("membership=" + (str)b1 + (str)b2 + (str)b3)
print("identity=" + (str)id1 + (str)id2)

int x = 10
int t1 = x > 5 ? 1 : 0
int t2 = 1 if x > 5 else 0
print("ternary=" + (str)t1 + (str)t2)
print("DONE")
