# D2-32b 边界：生成器体内 await 真挂起（数据未就绪时才透出 Waitable）
# doc: docs/KNOWN_LIMITS.md §二十四
# 期望: 数据未就绪时 recv 挂起 → 记录是否触发 "unexpected event" 或正常

# expect-class: PASS
# expect-out: PRODUCER_ABOUT_TO_SEND | PRODUCER_SENT | x=42 | DONE
# expect-exit: 0
# expect-llm: false
chan c = chan(int, "stream")

func take() -> int:
    int v = await c.recv()
    yield v

func producer() -> void:
    print("PRODUCER_ABOUT_TO_SEND")
    c.send(42)
    print("PRODUCER_SENT")

thread[void] t = thread(callable=producer, args=[])

for int x in take():
    print("x=" + (str)x)
print("DONE")
