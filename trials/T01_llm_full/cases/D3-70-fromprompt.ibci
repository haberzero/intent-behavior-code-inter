# D3-70 协议：用户类 __from_prompt__ + __outputhint_prompt__ 自定义解析
# doc: docs/syntax/06_oop.md §6.6 + docs/syntax/07_behavior_expressions.md §7.4（TYPE 需 LLM 解析能力）
# NOTE(DOC-ISSUE-007): __from_prompt__ 实际契约返回 (bool, instance) 元组，
#  docs/06_oop.md §6.6 未注明；此处按 tests/e2e/test_prompt_protocol_e2e.py 正确写法
# 期望: LLM 输出经 __from_prompt__ 解析为用户类实例

# expect-class: PASS
# expect-out: mood=开心 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Mood:
    str label
    func __init__(self, str label) -> auto:
        self.label = label
    func __from_prompt__(self, str raw) -> tuple:
        str t = raw.strip()
        return (True, Mood(t))
    func __outputhint_prompt__(self) -> str:
        return "只输出一个词：开心 或 难过 或 平静"
    func __to_prompt__(self) -> str:
        return self.label

Mood m = @~ 今天天气很好，什么心情？ ~
print("mood=" + m.label)
print("DONE")
