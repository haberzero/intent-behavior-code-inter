# D1-07-002 类型约束输出格式 -> int/bool/list
# doc: docs/syntax/07_behavior_expressions.md §7.2
# 期望: int/bool/list 解析正确（真实 LLM 格式服从）

# expect-class: PASS
# expect-out: answer=2 | ok=True | pi_ok=True | tags_len=3 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
int answer = @~ 1+1 等于几？只答数字 ~
print("answer=" + (str)answer)

bool ok = @~ 1+1=2 吗？只答 1 或 0 ~
print("ok=" + (str)ok)

float pi = @~ pi 约等于多少？只答数字 ~
bool pi_ok = pi > 3.0 and pi < 4.0
print("pi_ok=" + (str)pi_ok)

list[str] tags = @~ 给"苹果"打3个中文标签，JSON数组格式 ~
print("tags_len=" + (str)tags.len())
print("DONE")
