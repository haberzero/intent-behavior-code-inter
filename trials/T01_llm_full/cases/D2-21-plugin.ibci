# D2-21 宿主绑定：import python "math" as m: bind sqrt/pow（用户扩展唯一通道）
# doc: docs/architecture/01_native_host_binding.md
# 期望: 绑定 Python 标准库 math；m.sqrt/m.pow 调用成功

# expect-class: PASS
# expect-out: sqrt=4.0 | pow=1024.0 | DONE
# expect-exit: 0
# expect-llm: false
import python "math" as m:
    bind sqrt(x: float) -> float
    bind pow(x: float, y: float) -> float

float result1 = m.sqrt(16.0)
print("sqrt=" + (str)result1)
float result2 = m.pow(2.0, 10.0)
print("pow=" + (str)result2)
print("DONE")
