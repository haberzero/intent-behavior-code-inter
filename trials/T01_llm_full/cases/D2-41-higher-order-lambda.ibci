import ai
ai.load_project_config()
@+ 回复要极简，不超过6字
func run2(fn[(str) -> str] cb, str input) -> str:
    return cb(input)

fn cb = lambda(str x) -> str: @~ 用中文回复：$x ~
str r = run2(cb, "你好")
@-
print("r=" + r)
