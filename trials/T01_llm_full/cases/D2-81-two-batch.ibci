# D2-81 并发压力：两路 run_batch 同时进行（调度器多批并发）
# doc: docs/syntax/14_concurrency.md
# 期望: 多批 run_batch 并发无交错/无竞态

# expect-class: PASS
# expect-out: ra=2 | rb=3 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()

fn a = lambda(str x) -> str: @~ 用两个字回答：$x ~
fn b = lambda(str y) -> str: @~ 用三个字回答：$y ~

list ra = ai.run_batch(a, ["猫", "狗"])
list rb = ai.run_batch(b, ["山", "水", "风"])
print("ra=" + (str)ra.len())
print("rb=" + (str)rb.len())
for any x in ra:
    print("a=" + (str)x)
for any y in rb:
    print("b=" + (str)y)
print("DONE")
