# D2-36 多可能性：llmexcept retry body 内 file.write（SEM_LLMEXCEPT_FILE_WRITE 拦截）
# doc: docs/syntax/10_robustness.md §10.3 磁盘型 + docs/KNOWN_LIMITS.md §二十
# 期望: 编译期 SEM_LLMEXCEPT_FILE_WRITE 拦截

# expect-class: GUARD
# expect-code: SEM_LLMEXCEPT_FILE_WRITE
# expect-exit: nonzero
# expect-llm: true
import ai
import file
ai.load_project_config()

file_handle fh = file.open("data.txt")
str result = @~ 根据 $fh 总结内容 ~
llmexcept:
    file.write(fh, "mutated", overwrite_flag="overwrite")
    retry "请只返回摘要"
print("DONE")
