# KI-2：Optional 默认参数深克隆保 _is_some / 容器默认参数独立克隆
# doc: docs/architecture/03_type_system.md §8
# expect-class: PASS
# expect-out: True | True | 3 | 3
# expect-exit: 0
func f(Optional[int] x = None) -> bool:
    return x is None
func g(list[Optional[int]] xs = [None, 5]) -> int:
    xs.append(None)
    return len(xs)
print(f())
print(f(None))
print(g())
print(g())
