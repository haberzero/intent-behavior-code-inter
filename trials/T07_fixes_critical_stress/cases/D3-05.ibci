# set_mock_mode mock→真实→mock 往返真实 LLM 调用
# doc: docs/syntax/11_modules.md
# expect-class: PASS
# expect-out: 42 | 7 | 99 | done
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
ai.set_mock_mode()
int r1 = @~ MOCK:INT 42 ~
print(r1)
ai.set_mock_mode(False)
int r2 = @~ 只返回数字 7 ~
print(r2)
ai.set_mock_mode()
int r3 = @~ MOCK:INT 99 ~
print(r3)
print("done")
