# 幽灵码观察：未声明属性读取（p.y）→ 抛 RUN_ATTRIBUTE_ERROR（ATTR-READ-1 修复后核销）
# doc: docs/syntax/15_diagnostics.md RUN_ATTRIBUTE_ERROR
# expect-class: PASS
# expect-code: RUN_ATTRIBUTE_ERROR
# expect-exit: nonzero
class Point:
    int x
    func __init__(self, int x) -> auto:
        self.x = x
Point p = Point(1)
print(p.y)
