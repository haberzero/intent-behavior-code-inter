# T11-L1 真实 LLM：stream_call await 完整文本（llm 可调用类流式消费面）
# doc: docs/syntax/11_modules.md §11.3
# expect-class: PASS
# expect-out: len_gt0=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 简洁:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "只回答：你好世界", "prompt_slots": [{"kind": "user_sys", "text": "你是一个简洁的助手，只输出结果。"}]}
简洁 s = 简洁()
str full = await ai.stream_call(s)
print("len_gt0=" + (str)(full.len() > 0))
print("DONE")
