# T11-M5 ai.run_batch 统一消费 llm 可调用实例（每 item 一次调用，expected_type int）
# doc: docs/syntax/08_llm_callable.md §8.3
# expect-class: PASS
# expect-out: total=12 | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
class 加倍:
    func __llm_call__(self, any item) -> dict:
        return {"user_prompt": "MOCK:INT:" + str(item * 2), "expected_type": "int"}
加倍 g = 加倍()
list results = ai.run_batch(g, [1, 2, 3])
print("total=" + (str)(results[0] + results[1] + results[2]))
print("DONE")
