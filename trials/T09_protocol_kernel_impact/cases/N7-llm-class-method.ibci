# T09-N7 类内 llm 可调用方法真实调用（P4c 迁移：llm func 方法 → llm 可调用类 __llm_call__）
# doc: docs/syntax/09_llm.md
# expect-class: PASS
# expect-out: classmethod_ok=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Parser:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "提取数字：42", "prompt_slots": [{"kind": "user_sys", "text": "你只返回一个整数，禁止任何其它内容。"}], "expected_type": "int"}

Parser p = Parser()
int v = p()
print("classmethod_ok=" + (str)(v == 42))
print("DONE")