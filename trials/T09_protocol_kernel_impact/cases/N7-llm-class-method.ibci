# T09-N7 类内 LLM 方法真实调用（类方法统一路径）
# doc: docs/syntax/08_llm_functions.md
# expect-class: PASS
# expect-out: classmethod_ok=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Parser:
    llm func parse(self) -> int:
__sys__
你只返回一个整数，禁止任何其它内容。
__user__
提取数字：42
llmend

Parser p = Parser()
int v = p.parse()
print("classmethod_ok=" + (str)(v == 42))
print("DONE")
