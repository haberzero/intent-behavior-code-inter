# T09-N2 impl 补方法 + 泛型协议 bound + 真实 LLM 输出作实参
# doc: docs/syntax/06_oop.md §6.8 + docs/syntax/01_types.md 泛型
# expect-class: PASS
# expect-out: bound_ok=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
protocol Greeter:
    func greet(self) -> str:
        pass

class Widget:
    str label

impl Greeter for Widget:
    llm func greet(self) -> str:
__sys__
你只输出给定单词的英文翻译，禁止任何其它内容。
__user__
标签：苹果
llmend

class Box[T: Greeter]:
    T value
    func get(self) -> T:
        return self.value

Widget w = Widget("w1")
Box[Widget] b = Box[Widget](w)
str g = b.get().greet()
print("bound_ok=" + (str)(g.len() > 0 and g != "苹果"))
print("DONE")
