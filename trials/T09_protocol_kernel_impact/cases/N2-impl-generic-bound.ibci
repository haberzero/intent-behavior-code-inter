# T09-N2 impl 补方法 + 泛型协议 bound（P4c 迁移：impl 内 LLM 方法机制删除，方法恒普通 func）
# doc: docs/syntax/06_oop.md §6.8 + docs/syntax/01_types.md 泛型
# expect-class: PASS
# expect-out: bound_ok=True | DONE
# expect-exit: 0
import ai
ai.load_project_config()
protocol Greeter:
    func greet(self) -> str:
        pass

class Widget:
    str label

impl Greeter for Widget:
    func greet(self) -> str:
        return "apple"

class Box[T: Greeter]:
    T value
    func get(self) -> T:
        return self.value

Widget w = Widget("w1")
Box[Widget] b = Box[Widget](w)
str g = b.get().greet()
print("bound_ok=" + (str)(g.len() > 0 and g != "苹果"))
print("DONE")