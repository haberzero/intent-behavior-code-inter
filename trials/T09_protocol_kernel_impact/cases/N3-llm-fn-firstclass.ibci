# T09-N3 llm 可调用类实例直接调用（P4c 迁移：llm 函数 → llm 可调用类，实例调用即 LLM 调用）
# doc: docs/syntax/09_llm.md
# expect-class: PASS
# expect-out: firstclass_ok=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 问数:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "返回 42", "prompt_slots": [{"kind": "user_sys", "text": "你只返回一个整数，禁止任何其它内容。"}], "expected_type": "int"}

问数 inst = 问数()
int v = inst()
print("firstclass_ok=" + (str)(v == 42))
print("DONE")