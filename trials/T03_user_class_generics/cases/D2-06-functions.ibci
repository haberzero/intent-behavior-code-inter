# D2-06 泛型 × 函数（参数/返回泛型类）
# doc: docs/syntax/06_oop.md §6.4 + 05_functions
# 期望: 泛型实例作函数参数与返回
# expect-class: PASS
# expect-out: r=55 | s=hello | DONE
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

func extract_int(Box[int] b) -> int:
    return b.get()

int r = extract_int(Box[int](55))
print("r=" + (str)r)

func extract_str(Box[str] b) -> str:
    return b.get()

str s = extract_str(Box[str]("hello"))
print("s=" + s)
print("DONE")
