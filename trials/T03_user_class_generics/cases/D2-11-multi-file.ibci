# D2-11 泛型 × 多文件（跨模块泛型类 import 后特化）
# doc: docs/syntax/06_oop.md §6.4 + docs/syntax/11_modules.md
# 期望: 跨文件泛型类可特化使用
# expect-class: PASS
# expect-out: pop1=2 | pop2=1 | DONE
import ai
import helper_generics
ai.set_mock_mode()
helper_generics.Stack[int] si = helper_generics.Stack[int]()
si.push(1)
si.push(2)
print("pop1=" + (str)si.pop())
print("pop2=" + (str)si.pop())
print("DONE")
