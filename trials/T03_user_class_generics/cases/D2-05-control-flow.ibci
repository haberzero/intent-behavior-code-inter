# D2-05 泛型 × 控制流（for 泛型列表 / switch 泛型值 / if 泛型字段）
# doc: docs/syntax/06_oop.md §6.4 + docs/syntax/04_control_flow.md §4.6
# 期望: 泛型实例参与控制流
# expect-class: PASS
# expect-out: sum=6 | DONE
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

list[Box[int]] boxes = [Box[int](1), Box[int](2), Box[int](3)]
int sum = 0
for Box[int] b in boxes:
    sum = sum + b.get()
print("sum=" + (str)sum)

Box[str] bs = Box[str]("on")
if bs.get() == "on":
    print("switched_on")
else:
    print("switched_off")

switch bs.get():
    case "on":
        print("case_on")
    default:
        print("case_other")
print("DONE")
