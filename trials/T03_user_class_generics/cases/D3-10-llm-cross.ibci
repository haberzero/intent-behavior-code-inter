# D3-10 恶意：LLM 交叉（@~ 初始化泛型类字段 / llmexcept 重试泛型字段）
# doc: docs/syntax/06_oop.md §6.4 + 10_llmexcept
# 期望: 泛型字段经 LLM 初始化 + llmexcept 保护泛型状态
# expect-class: PASS
# expect-out: c1=7 | preserved=orig | DONE
import ai
ai.set_mock_mode()
class Cell[T]:
    T payload
    func get(self) -> T:
        return self.payload

Cell[int] c1 = Cell[int](0)
c1.payload = @~ MOCK:STR:7 ~
print("c1=" + (str)c1.get())

Cell[str] c2 = Cell[str]("orig")
try:
    c2.payload = @~ MOCK:FAIL boom ~
except:
    print("caught")
print("preserved=" + c2.get())
print("DONE")
