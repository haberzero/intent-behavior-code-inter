# T13-I-L2 真实 LLM：snapshot 冻结定义时意图 vs lambda 调用点 live（输出服从观测）
# doc: docs/syntax/09_intent_system.md §9.2 + docs/syntax/07_behavior_expressions.md §7.4
# expect-class: PASS
# expect-out: lam_obey=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
fn snap = snapshot -> str: @~ 只输出一个字：A ~
fn lam = lambda -> str: @~ 只输出两个字：BANANA ~
@+ 只输出三个字：CAT
str s1 = snap()
str l1 = lam()
print("snap_not_cat=" + (str)("CAT" not in s1))
print("lam_obey=" + (str)("BANANA" in l1))
@-
print("DONE")
