# T15-E-M18 [边界清单 #31] 线程内 LLM 调用 + llmexcept 组合（并发 + 容错交叉）
# doc: docs/syntax/14_concurrency.md §14.5 + docs/syntax/10_robustness.md
# expect-class: PASS
# expect-out: got=7 | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
func worker() -> int:
    int v = 0
    try:
        int x = @~ MOCK:INT:7 提取数字 ~
        v = x
    except Exception:
        v = 0
    return v
thread[int] t = thread(callable=worker, args=[])
thread_result[int] r = t.join()
print("got=" + (str)r.expect())
print("DONE")
