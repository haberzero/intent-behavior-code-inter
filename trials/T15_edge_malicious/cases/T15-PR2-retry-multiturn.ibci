# T15-PR2 压力：__retry__ 多轮 message_history 回喂（真实多轮对话累积）
# doc: docs/syntax/08_llm_callable.md §8.4 + docs/syntax/10_robustness.md §10.5
# expect-class: PASS
# expect-out: got=3 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 取数:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "返回数字 3，但先写一句无关的话。", "expected_type": "int"}
    func __retry__(self) -> dict:
        return {"max_retry": 3, "hint": "只返回数字 3 本身，不要任何其它文字。"}
取数 g = 取数()
int v = g()
print("got=" + (str)v)
print("DONE")
