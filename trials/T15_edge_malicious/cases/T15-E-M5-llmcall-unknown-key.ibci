# T15-E-M5 [边界清单 #8] __llm_call__ 装配 dict 未知键：忽略或报错？（观测）
# doc: docs/syntax/08_llm_callable.md §8.1
# expect-class: PASS
# expect-out: val=ok | DONE
# expect-exit: 0
# expect-llm: false
import ai
ai.set_mock_mode()
class 未知键:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "MOCK:STR:\"ok\"", "bogus_key": 123}
未知键 u = 未知键()
str v = u()
print("val=" + v)
print("DONE")
