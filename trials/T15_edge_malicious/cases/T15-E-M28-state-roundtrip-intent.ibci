# T15-E-M28 [边界清单 #16] 序列化 round-trip 保真（KERNEL_ISSUE-SER-1 回归门）：
#   ctx.push 持久意图 + 返回类型提示覆写 → save_state → save 后变更（@S2 / AFTER_PROMPT）
#   → load_state → 恢复态三断言：持久意图保真 / save 后变更被丢弃 / 插件状态（返回类型提示）
#   round-trip 保真；模块绑定活体保持（SER-1：load 后 ai 成员可访问，无死壳覆盖）
# doc: docs/howto/use_isolation.md + docs/subsystems/01_intent_system.md §6 槽位序列化
# expect-class: PASS
# expect-out: has_s1=True | no_s2=True | rt=OVERRIDE_INT_PROMPT | DONE
# expect-exit: 0
# expect-llm: false
import ai
import ihost
ai.set_mock_mode()
intent_context ctx = intent_context.get_current()
ctx.push("S1")
intent_context.use(ctx)
ai.set_return_type_prompt("int", "OVERRIDE_INT_PROMPT")
ihost.save_state("./logs/m28_state.json")
@ "S2"
ai.set_return_type_prompt("int", "AFTER_PROMPT")
ihost.load_state("./logs/m28_state.json")
str r = @~ 输出: x ~
dict info = ai.get_current_call_info()
print("has_s1=" + (str)("S1" in (str)info["intents"]["merged"]))
print("no_s2=" + (str)("S2" not in (str)info["intents"]["merged"]))
print("rt=" + (str)ai.get_return_type_prompt("int"))
print("DONE")
