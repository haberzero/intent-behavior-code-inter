# T15-E-M6 [边界清单 #13] 直接调用 f(args) 实参多于声明参数 → fail-fast（守卫生效，非静默忽略）
# doc: docs/syntax/08_llm_callable.md §8.2
# expect-class: GUARD
# expect-out: RuntimeError: VM: Call failed: VM: too many positional arguments for callable.
# expect-exit: nonzero
# expect-llm: false
import ai
ai.set_mock_mode()
class 单参:
    func __llm_call__(self, any a) -> dict:
        return {"user_prompt": "MOCK:STR:\"ok\""}
单参 s = 单参()
str v = s(1, 2)
print("got=" + v)
print("DONE")
