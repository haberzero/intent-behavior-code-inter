# T14-OPT-M2 Optional 容器元素：Optional[list[int]] 有值包装后 unwrap 使用
# doc: docs/syntax/01_types.md §1.3.1
# expect-class: PASS
# expect-out: some=True first=1 | DONE
# expect-exit: 0
# expect-llm: false
Optional[list[int]] maybe = [1, 2, 3]
bool some = maybe.is_some()
list[int] lst = maybe.unwrap()
print("some=" + (str)some + " first=" + (str)lst[0])
print("DONE")
