# T17-K-M1 knowledge store/get round-trip + 未登记 null
# doc: docs/syntax/16_knowledge_system.md
# expect-class: PASS
# expect-out: got=在修真世界观中修炼指系统提升 | null=True | DONE
# expect-exit: 0
# expect-llm: false
func c(any x) -> bool:
    return x.len() > 0
knowledge kb = knowledge()
kb.store("term:修炼", "在修真世界观中修炼指系统提升", c)
str got = (str)kb.get("term:修炼")
any missing = kb.get("nope")
bool is_null = (missing == None)
print("got=" + got)
print("null=" + (str)is_null)
print("DONE")
