# T08-D2-01 用户类 LLM 协议族：__to_prompt__/__outputhint_prompt__/__from_prompt__ 真实链路
# doc: docs/syntax/06_oop.md §6.7 + docs/syntax/07_behavior_expressions.md §7.4
# expect-class: PASS
# expect-out: got=开心 | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Mood:
    str label
    func __init__(self, str label) -> auto:
        self.label = label
    func __to_prompt__(self) -> str:
        return self.label
    func __from_prompt__(self, str raw) -> tuple:
        return (True, Mood(raw.strip()))
    func __outputhint_prompt__(self) -> str:
        return "只输出一个词：开心 或 难过 或 平静"

Mood m = @~ 今天天气很好，心情是什么？ ~
print("got=" + m.label)
print("DONE")
