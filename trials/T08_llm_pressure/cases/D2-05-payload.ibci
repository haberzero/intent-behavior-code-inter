# T08-D2-05 自定义 __payload_prompt__ 返回 text block 插值到真实 LLM
# doc: docs/syntax/07_behavior_expressions.md §7.6
# expect-class: PASS
# expect-out: payload_ok=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Payload:
    func __init__(self) -> auto:
        pass
    func __payload_prompt__(self) -> dict:
        return {"type": "text", "text": "PAYLOAD_TOKEN_ABC"}
    func __to_prompt__(self) -> str:
        return "FALLBACK_TEXT"

Payload p = Payload()
str r = @~ 请只原样输出我提供给你的 token：$p ~
print("payload_ok=" + (str)("PAYLOAD_TOKEN_ABC" in r))
print("DONE")
