# T08-D5-02 流式通道 ai.stream_channel 真实 LLM：逐块消费
# doc: docs/syntax/11_modules.md §11.3
# expect-class: PASS
# expect-out: got_gt0=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 简洁回答:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "只回答：HELLO", "prompt_slots": [{"kind": "user_sys", "text": "你是一个简洁的助手。"}]}
简洁回答 s = 简洁回答()
chan chunks = ai.stream_channel(s)
str first = chunks.recv()
print("got_gt0=" + (str)(first.len() > 0))
print("DONE")
