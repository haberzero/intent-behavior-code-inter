# T08-D4-02 llm 可调用类返回 auto 语义（llm 函数 → llm 可调用类；无 expected_type 时按 str 解析）
# doc: docs/syntax/09_llm.md
# expect-class: PASS
# expect-out: is_str=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 说:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "只回答：HI", "prompt_slots": [{"kind": "user_sys", "text": "你是一个简洁的助手。"}]}

说 inst = 说()
auto r = inst()
print("is_str=" + (str)(type(r) == "str"))
print("DONE")