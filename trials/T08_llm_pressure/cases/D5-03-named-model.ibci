# T08-D5-03 命名模型路由 @NAME~ 真实 LLM（同一本地端点注册别名）
# doc: docs/syntax/07_behavior_expressions.md §7.5
# expect-class: PASS
# expect-out: named_len=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
import python "os" as oslib:
    bind getenv(key: str) -> str
ai.load_project_config()
str key = oslib.getenv("IBCI_TRIAL_LLM_KEY")
ai.register_model("ALT", "http://localhost:8001/v1", key, "Qwen3.6-35B-A3B")
str s = @ALT~ 只回答：NAMED_OK ~
print("named_len=" + (str)(s.len() > 0))
print("DONE")
