# T08-D5-03 命名模型路由 @NAME~ 真实 LLM（环境声明端点注册别名——
# 机器事实走 env 通道：IBCI_TRIAL_LLM_URL / IBCI_TRIAL_LLM_MODEL /
# IBCI_TRIAL_LLM_KEY）
# doc: docs/syntax/07_behavior_expressions.md §7.5
# expect-class: PASS
# expect-out: named_len=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
import ihost
ai.load_project_config()
str key = ihost.getenv("IBCI_TRIAL_LLM_KEY")
str url = ihost.getenv("IBCI_TRIAL_LLM_URL")
str model_id = ihost.getenv("IBCI_TRIAL_LLM_MODEL")
ai.register_model("ALT", url, key, model_id)
str s = @ALT~ 只回答：NAMED_OK ~
print("named_len=" + (str)(s.len() > 0))
print("DONE")
