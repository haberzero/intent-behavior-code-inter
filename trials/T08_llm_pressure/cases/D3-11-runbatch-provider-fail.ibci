# T08-D3-11 run_batch provider 失败：应抛 LLMCallError 可捕获
# doc: docs/syntax/07_behavior_expressions.md §7.4 + docs/syntax/10_robustness.md
# expect-class: PASS
# expect-out: caught=True | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.set_config("http://127.0.0.1:1/v1", "bad", "bad-model")
fn f = lambda(str x) -> str: @~ 处理 $x ~
try:
    list res = ai.run_batch(f, ["a", "b"])
    print("len=" + (str)res.len())
    print("no_catch")
except LLMCallError as e:
    print("caught=True")
except Exception as e:
    print("caught_exception")
print("DONE")
