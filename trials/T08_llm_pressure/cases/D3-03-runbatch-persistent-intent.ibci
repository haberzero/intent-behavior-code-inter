# T08-D3-03 @+ 持久意图 + ai.run_batch：模型服从性观察（注入正确性由 D3-05 观测）
# doc: docs/syntax/09_intent_system.md §9.1
# expect-class: LLM_BEHAVIOR
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
@+ 只输出一个词：BANANA
fn f = lambda(str x) -> str: @~ 用一词回应 $x ~
list res = ai.run_batch(f, ["苹果", "香蕉", "橙子"])
@-
bool all_ok = True
for any item in res:
    if "BANANA" not in (str)item:
        all_ok = False
print("all_ok=" + (str)all_ok)
print("DONE")
