# T08-D4-05 llm 可调用类返回用户类（__from_prompt__；llm 函数 → llm 可调用类）
# doc: docs/syntax/09_llm.md + docs/syntax/06_oop.md §6.7
# expect-class: PASS
# expect-out: got=OK | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class Resp:
    str text
    func __init__(self, str text) -> auto:
        self.text = text
    func __from_prompt__(self, str raw) -> tuple:
        return (True, Resp(raw.strip()))
    func __outputhint_prompt__(self) -> str:
        return "只输出 OK"

class 取响应:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "只回答：OK", "prompt_slots": [{"kind": "user_sys", "text": "你是一个简洁的助手。"}], "expected_type": "Resp"}

取响应 inst = 取响应()
Resp r = inst()
print("got=" + r.text)
print("DONE")