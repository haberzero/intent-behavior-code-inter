# T08-D4-03 llm 可调用类实例直接调用（llm 函数 → llm 可调用类；实例调用即 LLM 调用）
# doc: docs/syntax/09_llm.md
# expect-class: PASS
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 问候:
    func __llm_call__(self, any name) -> dict:
        return {"user_prompt": "向 " + str(name) + " 问好，只回答你好。", "prompt_slots": [{"kind": "user_sys", "text": "你是一个友好的助手。"}]}

问候 greet = 问候()
str r = greet("张三")
print("r_len=" + (str)(r.len() > 0))
print("DONE")