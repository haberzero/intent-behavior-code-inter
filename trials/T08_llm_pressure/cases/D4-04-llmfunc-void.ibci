# T08-D4-04 llm 可调用类无 expected_type：结果按原始 str 返回（08_llm_callable.md）
# doc: docs/syntax/08_llm_callable.md
# expect-class: PASS
# expect-out: s=OK | DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
class 报告:
    func __llm_call__(self) -> dict:
        return {"user_prompt": "只回答：OK"}

报告 r = 报告()
str s = r()
print("s=" + s)
print("DONE")