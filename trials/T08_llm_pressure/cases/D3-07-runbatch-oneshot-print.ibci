# T08-D3-07 run_batch + @! 排他意图：打印实际结果（观察首/后续差异）
# doc: docs/syntax/09_intent_system.md §9.1
# expect-class: LLM_BEHAVIOR
# expect-out: DONE
# expect-exit: 0
# expect-llm: true
import ai
ai.load_project_config()
fn f = lambda(str x) -> str: @~ 用一句话描述 $x ~
@! 只输出：FIRST_ONLY
list res = ai.run_batch(f, ["苹果", "香蕉"])
for any item in res:
    print("item=" + (str)item)
print("DONE")
