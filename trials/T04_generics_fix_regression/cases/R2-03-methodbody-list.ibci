# R2-03 G1 嵌套实参 Box[list[int]] 方法体
# doc: docs/syntax/06_oop.md §6.4
# 期望: 嵌套实参方法体命中特化
# expect-class: PASS
# expect-out: len=3 | first=1 | DONE
# expect-exit: 0
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value
    func make(self, T v) -> Box[T]:
        return Box[T](v)

Box[list[int]] bl = Box[list[int]]([])
Box[list[int]] bl2 = bl.make([1, 2, 3])
print("len=" + (str)bl2.get().len())
print("first=" + (str)bl2.get()[0])
print("DONE")
