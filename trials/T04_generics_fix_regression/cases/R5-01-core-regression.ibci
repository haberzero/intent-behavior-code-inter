# 泛型核心回归：Sub[int](7, "L") 多参构造（value+label 全链绑定）
# doc: docs/syntax/06_oop.md §6.4
# 期望输出: bi=42 / bs=hi / len=3 / box=2 / sub=7L / DONE
# expect-class: PASS
# expect-out: bi=42 | bs=hi | len=3 | box=2 | sub=7L | DONE
# expect-exit: 0
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value
class Pair[K, V]:
    K key
    V val
class Sub[T](Box[T]):
    str label

Box[int] bi = Box[int](42)
Box[str] bs = Box[str]("hi")
Box[list[int]] bl = Box[list[int]]([1, 2, 3])
list[Box[int]] boxes = [Box[int](1), Box[int](2)]
Sub[int] sb = Sub[int](7, "L")
print("bi=" + (str)bi.get())
print("bs=" + bs.get())
print("len=" + (str)bl.get().len())
print("box=" + (str)boxes[1].get())
print("sub=" + (str)sb.get() + sb.label)
print("DONE")
