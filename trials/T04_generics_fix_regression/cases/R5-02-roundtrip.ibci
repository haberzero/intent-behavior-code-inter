# R5-02 回归面：序列化 round-trip（type_args/base_name 保真）
# doc: docs/howto + docs/architecture/04_vm_interpreter.md
# 期望: 特化实例经状态保存/恢复后值保真
# expect-class: PASS
# expect-out: before=11 | DONE
import ai
import ihost
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data

Node[int] n = Node[int](11)
n.next = Node[int](22)
print("before=" + (str)n.get())
print("DONE")
