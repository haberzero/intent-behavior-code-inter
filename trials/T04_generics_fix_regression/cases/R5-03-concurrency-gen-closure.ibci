# R5-03 回归面：泛型 × 并发/生成器/闭包
# doc: docs/syntax/06_oop.md §6.4 + docs/syntax/14_concurrency.md + docs/syntax/05_functions.md
# 期望: 跨面泛型正常（KERNEL_ISSUE-CHAN-ARGS-1 触发用例：chan(Box[int],...) 显式类型实参被降级为 chan[Box]，编译期 SEM_TYPE_MISMATCH，修复后期望 = 全输出）
# expect-class: PASS
# expect-out: chan=5 | gen_sum=3 | closure=15 | DONE
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value

chan[Box[int]] ch = chan()
ch.send(Box[int](5))
Box[int] from_chan = await ch.recv()
print("chan=" + (str)from_chan.get())

func gen_boxes() -> generator[Box[int]]:
    yield Box[int](1)
    yield Box[int](2)
int sum = 0
for Box[int] b in gen_boxes():
    sum = sum + b.get()
print("gen_sum=" + (str)sum)

fn_callable[int] add5 = lambda(int x) -> int: x + 5
Box[int] bb = Box[int](add5(10))
print("closure=" + (str)bb.get())
print("DONE")
