# R1-04 G2 自引用字段 + 容器
# doc: docs/syntax/06_oop.md §6.4
# 期望: list[Node[int]] 含自引用字段元素
# expect-class: PASS
# expect-out: a=1 | b=2 | len=2 | DONE
# expect-exit: 0
import ai
ai.set_mock_mode()
class Node[T]:
    T data
    Node[T] next = any
    func get(self) -> T:
        return self.data

list[Node[int]] nodes = [Node[int](1), Node[int](2)]
nodes[0].next = nodes[1]
print("a=" + (str)nodes[0].get())
print("b=" + (str)nodes[0].next.get())
print("len=" + (str)nodes.len())
print("DONE")
