# R4-01 双通道 Box[int].set("str") 负例（预期报错）
# doc: docs/syntax/06_oop.md §6.4
# 期望: SEM_TYPE_MISMATCH（方法参数类型检查）
# expect-class: GUARD
# expect-code: SEM_TYPE_MISMATCH
# expect-exit: nonzero
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func set(self, T v) -> void:
        self.value = v
Box[int] bi = Box[int](0)
bi.set("str")
print("DONE")
