# R2-09 G1 深层嵌套实参方法体（潜在递归/性能）
# doc: docs/syntax/06_oop.md §6.4
# 期望: 深层嵌套不崩不死循环
# expect-class: PASS
# expect-out: len=1 | inner=2 | DONE
import ai
ai.set_mock_mode()
class Box[T]:
    T value
    func get(self) -> T:
        return self.value
    func make(self, T v) -> Box[T]:
        return Box[T](v)

Box[list[dict[str, list[int]]]] deep = Box[list[dict[str, list[int]]]]([])
Box[list[dict[str, list[int]]]] deep2 = deep.make([{"a": [1, 2]}])
print("len=" + (str)deep2.get().len())
print("inner=" + (str)deep2.get()[0]["a"][1])
print("DONE")
